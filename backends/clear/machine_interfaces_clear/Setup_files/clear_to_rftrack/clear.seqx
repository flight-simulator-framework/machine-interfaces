CA.SCT0850: monitor, L=0;
CA.SCT0875: monitor, L=0;

! -- Other instrumentation -----------------------------------------------------
! Inductive current transformers by Bergoz
CA.ICT0210  : MONITOR, L=0;
CA.ICT0395  : MONITOR, L=0;
CAS.ICT0430 : MONITOR, L=0;
