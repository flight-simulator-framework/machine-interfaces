CS.XLA0165,   AT=2.623589516+L_X+L_KJ+L_Q2+L_X/2+L_Q2/2 ,                                       FROM=CS.QFG0130;
CS.QFG0170,   AT=2.773589516+(2*L_X)+L_KJ+L_Q2+L_Q2 ,                                           FROM=CS.QFG0130;
CS.DHJ0175,   AT=3.3841+(2*L_X)+L_KJ+L_KJ/2+(2*L_Q2)+L_Q2/2 ,                                     FROM=CS.QFG0130;
CS.BPM0185,   AT=3.5293+(2*L_X)+(2*L_KJ)+(2*L_Q2)+L_Q2/2+L_iBPM_mech/2,                           FROM=CS.QFG0130;         ! Exact numbers     AT=0.793451966+0.1+0.15+1.28679476+0.986794756+0.15+0.2+(2*L_X)+(2*L_KJ)+(2*L_Q2)+L_iBPM_mech/2

CS.BHB0200,   AT=3.799041482+(2*L_X)+(2*L_KJ)+(2*L_Q2)+L_iBPM_mech+L_Q2/2+CS.SBHB0200/2,        FROM=CS.QFG0130;         !CS.BHB0200,   AT=0.13+CS.SBHB0200/2+0.120/2, FROM=CS.BPM0185;

!CS.BHB0200E,  AT=CS.SBHB0200/2,                                                                 FROM=CS.BHB0200;         ! Marker at end of dipole arc

CS.BTV0305,   AT=0.1655+CS.SBHB0200/2,                                                          FROM=CS.BHB0200;       !CS.BTV0305,   AT=0.15+CS.SBHB0200/2,     FROM=CS.BHB0200;
CS.DHJ0310,   AT=0.3605+L_KJ/2+CS.SBHB0200/2,                                                   FROM=CS.BHB0200;
CS.QFG0315,   AT=0.4905+L_KJ+L_Q2/2+CS.SBHB0200/2,                                              FROM=CS.BHB0200;       ! Positioned at 29.306384042 m absolute (SS & GT Jan26)
!CS.Q0315E,    AT=0.1+0.15+0.1+L_KJ+L_Q2,                                                        FROM=CS.BHB0200E;       ! Marker
CS.QDG0320,   AT=0.3+L_Q2 ,                                                                     FROM=CS.QFG0315;         !CS.QDG0320,   AT=0.3+L_Q2 ,      FROM=CS.QFG0315;
