!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!! (Avni Aksoy sept 2023)
! ELEMENTS for second beam line
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

! new quadrupoles for second beamline
! two new family is addded to the beamline PXMQNBH8WP PXMXNABNWP (AA Sept 2023)
! same family QFG/QDG

!!!! Qudrupoles

L_Q2 = 0.3; !Magnetic length of Quadrupoles
L_X  = 0.1; !Magnetic length of sextupoles
L_Q2_mechL        = 0.253; ! Quadrupole PXMQNBH8WP
L_X_mechL         = 0.065; ! Sextupole PXMXNABNWP


!!!! Davide, March 2026: 
!!!!  Values used by Avni:
!CS.ECQF    = 0.057;                 ! excitation constant dB/dx/I = 0.057 T/Am for quad --> needs to be checked??
!!!!  Values recovered from CTF3 model (note, here is mentioned model ECQF, but model should be ECQG if keeping CTF3 conventions! => to be updated
CS.ECQF     = 2.4/0.300/200;    ! GL[T]/L[m]/I[A]  From note AT-MTM-IN-2006-018
!!!!  If one uses values reported in https://norma-db.web.cern.ch/magdesign/idcard/298/
!!!!    and in particular https://edms.cern.ch/document/743579/1 at 200 A it should be:
!!!!   L = 2.401 [T] / 8.198 [T/m] /  = 0.293 m 
!!!!   But presently being used modelled with LQ2 = 0.3 m
!!!!   => the value from CTF3 above seems correct for the assumed length.
!
CS.FQF     = CLIGHT*1E-6*CS.ECQF;  ! conversion to k1 for second BL

!!!! Davide, March 2026:
!!!!  Values used by Avni: 
CS.ECXF    = 0.6;                 ! excitation constant dB/dx/I = 0.6 T/Am for sext--> needs to be checked??
!!!!  Still to look at https://norma-db.web.cern.ch/magdesign/idcard/373/
!!!!  Looking at CTF3 model, they were of type "ECXI", type FXB, here called by Avni(?) FXF
!!!!    Sint = 6.568 T/m at 100A /EDMS no 754421/ AT-MTM-IN-2006-032
!!!!    Lmodel =0.1 (as done for CLEAR)
CS.ECXF = 6.568 / 0.1 / 100; 
! 
CS.FXF     = CLIGHT*1E-6*CS.ECXF;  ! conversion to k2 for second BL


CS.QUAD: QUADRUPOLE, L=L_Q2;
CS.QFG0130: CS.QUAD, k1 := CS.KQFG0130;
CS.QDG0155: CS.QUAD, k1 := CS.KQDG0155;
CS.QFG0170: CS.QUAD, k1 := CS.KQFG0170;

CS.QFG0315: CS.QUAD, k1 := CS.KQFG0315;
CS.QDG0320: CS.QUAD, k1 := CS.KQDG0320;
CS.QFG0325: CS.QUAD, k1 := CS.KQFG0325;

CS.QFG0525: CS.QUAD, k1 := CS.KQFG0525;
CS.QDG0535: CS.QUAD, k1 := CS.KQDG0535;
CS.QFG0545: CS.QUAD, k1 := CS.KQFG0545;


CS.KQFG0130 :=  CS.IQFG0130 * (CS.FQF / CA.EN) ;
CS.KQDG0155 :=  CS.IQDG0155 * (CS.FQF / CA.EN) ;
CS.KQFG0170 :=  CS.IQFG0170 * (CS.FQF / CA.EN) ;
CS.KQFG0315 :=  CS.IQFG0315 * (CS.FQF / CA.EN) ;
CS.KQDG0320 :=  CS.IQDG0320 * (CS.FQF / CA.EN) ;
CS.KQFG0325 :=  CS.IQFG0325 * (CS.FQF / CA.EN) ;
CS.KQFG0525 :=  CS.IQFG0525 * (CS.FQF / CA.EN) ;
CS.KQDG0535 :=  CS.IQDG0535 * (CS.FQF / CA.EN) ;
CS.KQFG0545 :=  CS.IQFG0545 * (CS.FQF / CA.EN) ;


!!! Sextupoles
CS.XLA0135 : SEXTUPOLE,  L= L_X, K2:= CS.KXLA0135;
CS.XLA0165 : SEXTUPOLE,  L= L_X, K2:= CS.KXLA0165;

CS.KXLA0135 :=  CS.IXLA0135 * (CS.FXF / CA.EN) ;
CS.KXLA0165 :=  CS.IXLA0165 * (CS.FXF / CA.EN) ;

!!!! Correctors
CS.DHJ0145: kicker, L=L_KJ,  hkick:=0, vkick:=0;
CS.DHJ0175: kicker, L=L_KJ,  hkick:=0, vkick:=0;
CS.DHJ0310: kicker, L=L_KJ,  hkick:=0, vkick:=0;
CS.DHJ0335: kicker, L=L_KJ,  hkick:=0, vkick:=0;
CS.DHJ0505: kicker, L=L_KJ,  hkick:=0, vkick:=0;

!!! screens
CS.BTV0120:  monitor, L=0;
CS.BTV0305:  monitor, L=0;
CS.BTV0420:  monitor, L=0;

CS.BTV0610:  monitor, L=0;
CS.BTV0700:  monitor, L=0;

!!! scatterers
CS.SCAT0500: INSTRUMENT, L=0;
CS.SCAT0515: INSTRUMENT, L=0;


!!! BPMs
CS.BPM0105:  monitor, L=L_iBPM_mech;
CS.BPM0185:  monitor, L=L_iBPM_mech;
CS.BPM0330:  monitor, L=L_iBPM_mech;
CS.BPM0510:  monitor, L=L_iBPM_mech;


!!! bending magnets
!
CS.ANG01002 = 22  * twopi/360;
CS.BHB01002: RBEND, L= CA.LBHB, ANGLE = CS.ANG01002,E1=CS.ANG01002/2,E2=CS.ANG01002/2;
CS.LCOR01002 = CA.LBHB/2 * ( 1/cos(CS.ANG01002/2) - CS.ANG01002/2/sin(CS.ANG01002/2) );
CS.SBHB01002=CS.ANG01002*(0.5*CA.LBHB/sin(CS.ANG01002/2));
!
CS.ANG0200 = -22  * twopi/360;
CS.SBHB0200=CS.ANG0200*(0.5*CA.LBHB/sin(CS.ANG0200/2));
CS.BHB0200: RBEND, L= CA.LBHB, E1=+CS.BHBE1, E2=-CS.BHBE1, ANGLE = CS.ANG0200, KTAP:=CS.REL_BEND_ERROR + CS.REL_BEND_SYS_ERROR*(1+CS.REL_BEND_ERROR);

!!! MARKERS Start of element
CS.BHB0100S:  MARKER;

!!! MARKERS End of element
CS.BHB0100E:  MARKER;
CS.BHB0200E:  MARKER;
CS.Q0130E:    MARKER;
CS.Q0315E:    MARKER;
CS.Q0325E:    MARKER;
CS.Q0545E:    MARKER;


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! -- CLEAR SECOND BEAMLINE  sequence ----------------------------------------------
!! (SS & GT Jan26)
!!
!! from CA.BTV0390  to the dump
!! approximate length is 16.4m

L_CLEAR2NDBL = 1.65e+01;

CS.2NDBL : SEQUENCE, L=L_CLEAR2NDBL;
!CA.ICT0395,  AT= 0.13-0.04; ! 13 cm downstream of BTV0390 (May 2025)

!CS.BHB01002, AT=(21.2454 - L_CLEAR_LINAC) - CS.LCOR01002;
!CS.BHB01002,  AT=0.410575094+CS.SBHB01002/2;
CS.BHB0100S,  AT=(BHB0100_Pos- L_CLEAR_LINAC); ! Start of dipole
CS.BHB0100,   AT=(BHB0100_Pos- L_CLEAR_LINAC)+ CS.SBHB0100_SecBL/2;      ! Middle of the dipole, half of the arc
!CS.BHB0100E,  AT=CS.SBHB0100_SecBL/2, FROM=CS.BHB0100;              ! Marker placed at the end of the dipole arc
CS.BPM0105,   AT=0.25+L_iBPM_mech/2+CS.SBHB0100_SecBL/2,                                        FROM=CS.BHB0100;     ! From end of coil it's 0.24, 0.13 from valve
!CS.BTV0120,   AT=(2*0.13) + L_iBPM_mech + CS.SBHB0100_SecBL/2,                                  FROM=CS.BHB0100;       ! Should be ~0.35 total
CS.BTV0120,   AT=0.885 + L_iBPM_mech + CS.SBHB0100_SecBL/2,                                    FROM=CS.BHB0100;

CS.QFG0130,   AT=1.243451966+L_Q2/2+CS.SBHB0100_SecBL/2,                                        FROM=CS.BHB0100;       ! CS.QFG0130,   AT=0.1+L_Q2/2 ,   FROM=CS.BTV0120; @ ~1.10m ;       START AT=1.243451966,        FROM=CS.BHB0100E;
!CS.Q0130E,    AT=1.35 + L_Q2,                                                                   FROM=CS.BHB0100E;       ! Marker
CS.XLA0135,   AT=0.15+L_X/2+L_Q2/2,                                                             FROM=CS.QFG0130;
