!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! The complete sequences, which are normally the ones used !!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


!!! vesper beamline
VESPER : SEQUENCE, L = L_CLEAR_LINAC + L_CALIFESDUMP, REFER=entry;
CA.LINAC,      AT = 0;
CA.VESPER,     AT = L_CLEAR_LINAC;
ENDSEQUENCE;


!!! clear all beamline
CLEARLINE : SEQUENCE, L = L_CLEAR_LINAC + L_STRAIGHT_BL + L_INAIR, REFER=entry;
CA.LINAC,      AT = 0;
CA.STRAIGHT,   AT = L_CLEAR_LINAC;
CA.INAIR,      AT = L_CLEAR_LINAC + L_STRAIGHT_BL;
ENDSEQUENCE;


!!! clear spectrometer beamline
CLEARSPECT   : SEQUENCE, L = L_CLEAR_LINAC + L_STRAIGHT_BL + L_CLSPEC, REFER=entry;
CA.LINAC,      AT = 0;
CA.STRAIGHT,   AT = L_CLEAR_LINAC;
CA.SPECT,      AT = L_CLEAR_LINAC + L_STRAIGHT_BL;
ENDSEQUENCE;


!!! clear second beamline
CLEAR2ND  : SEQUENCE, L = L_CLEAR_LINAC + L_CLEAR2NDBL, REFER=entry;
CA.LINAC,      AT = 0;
CS.2NDBL,      AT = L_CLEAR_LINAC;
ENDSEQUENCE;

!!! Lines defined for survey purposes
! same as CLEARSPECT
CA.SURVEY : SEQUENCE, L = L_CLEAR_LINAC + L_STRAIGHT_BL + L_CLSPEC, REFER=entry;
CA.LINAC,      AT = 0;
CA.STRAIGHT,   AT = L_CLEAR_LINAC;
CA.SPECT,      AT = L_CLEAR_LINAC + L_STRAIGHT_BL;
ENDSEQUENCE;

! same as CLEARSECOND, but without installing LINAC elements...
CS.SURVEY  : SEQUENCE, L = L_CLEAR_LINAC + L_CLEAR2NDBL, REFER=entry;
CS.2NDBL,      AT = L_CLEAR_LINAC;
ENDSEQUENCE;


